# Razorpay Test Mode credentials (copy values from Razorpay Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Keep this aligned with the currency used by room base prices. Current app pricing is USD.
RAZORPAY_CURRENCY=usd

# Set these to the real property location before using live weather forecasts.
RESORT_LOCATION_NAME=Demo Resort Location
RESORT_LATITUDE=15.2993
RESORT_LONGITUDE=74.1240
